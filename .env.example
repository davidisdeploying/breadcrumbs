# Copy to .env and fill in after running `npm run inspect`.
# No Kroger credentials live here — you log in interactively via `npm run login`.

# --- Output / state ---
OUTPUT_DIR=./receipts
# USER_DATA_DIR defaults to ~/.local/state/breadcrumbs/browser-profile.
# Set an absolute path only when intentionally overriding that state root.
LEDGER_PATH=./seen.json

# --- Run behavior ---
# true for unattended cron; set false + use a virtual display if Kroger challenges headless runs.
HEADLESS=true
# Also export each receipt as PDF (requires HEADLESS=true).
SAVE_PDF=false
# Leave blank to use Chromium's default user agent (recommended).
USER_AGENT=

# --- Kroger URLs (verify against your own account) ---
SIGNIN_URL=https://www.kroger.com/signin
ORDERS_URL=https://www.kroger.com/mypurchases

# --- Selectors (discover via `npm run inspect`) ---
# CSS selector matching the <a> links to each order's detail/receipt page.
SEL_ORDER_LINK=
# Optional: an element confirming the receipt page has loaded (otherwise a fixed wait is used).
SEL_RECEIPT_READY=

# --- Optional: capture Kroger's order JSON instead of/along with screenshots ---
# Substring of the order API URL you spotted in debug/network.json.
ORDER_API_MATCH=

# --- Optional: notifications (ntfy-style POST: body=message, Title header) ---
# Fires when new receipts arrive, the session expires, or a run fails. Leave blank to disable.
NOTIFY_WEBHOOK=

# --- Docker only: host path receipts are written to (mount target). Point at your NAS mount. ---
# e.g. RECEIPTS_DIR=$STORAGE_ROOT/kroger-receipts
RECEIPTS_DIR=./receipts

# --- Misc ---
TIMEOUT_MS=30000
